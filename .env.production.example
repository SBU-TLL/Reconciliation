###############################################################################
# Reconciliation — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. Reconciliation has NO SQL database and NO
# application API keys; storage is file-based under data/. This template
# documents the platform/auth contract and the external dependencies.
#
# Nothing here is baked into the image; the dev-only Shibboleth mock lives under
# .ddev/ and is excluded from the image (.dockerignore).
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
# The app is served under a "/reconciliation/" path prefix (the frontend
# hardcodes it in js/Modules/APIHandler.js; the image provides a
# reconciliation -> docroot symlink so it resolves).
PUBLIC_HOSTNAME=reconciliation.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080.
APACHE_LISTEN_PORT=8080

# --- Authentication (Shibboleth at the ingress) ------------------------------
# Shibboleth SSO is enforced at the ingress / reverse proxy (Ansible-managed),
# which supplies the $_SERVER attributes (eppn/nickname/sn/REMOTE_USER) the API
# reads. The image's root .htaccess <IfModule mod_shib> block is inert without
# mod_shib, so the proxy is the gate.
#   -> The Azure/Ansible deploy MUST assert mod_shib is loaded at the gate.
#      Without it the API falls back to a hardcoded default identity
#      (pstdenis@stonybrook.edu, an admin) — i.e. it is FAIL-OPEN if the gate is
#      ever missing. (Flagged for remediation; not changed here.)
# Admin accounts are a hardcoded allowlist in api/public/index.php
# (ikleiman/vlgarcia/chaotsai/pstdenis @stonybrook.edu) — not configured here.

# --- EXTERNAL internal-project dependency: the "checker" project -------------
# The root .htaccess redirects unauthenticated users to /checker/index.php — the
# separate internal "checker" app, NOT bundled in this image. It MUST be served
# at the same origin (deploy the checker container there, or route /checker/* to
# it via the ingress) or the unauthenticated fallback 404s.
CHECKER_REDIRECT_PATH=/checker/index.php

# --- Database ----------------------------------------------------------------
# NONE (no SQL). Per-student/patient data + logs + Excel dumps are files under
# /var/www/html/data. Mount a persistent volume there so data survives
# redeploys:
#   docker run -v reconciliation-data:/var/www/html/data ...

# --- Application secrets -----------------------------------------------------
# NONE. NOTE: api/public/index.php sends `Access-Control-Allow-Origin: *` on an
# authenticated API — tighten to the real origin(s) for production. (Flagged.)
